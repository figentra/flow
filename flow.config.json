{
  "$schema": "./packages/flow/schema/flow.config.schema.json",
  "version": 1,
  "preset": "stackra",
  "tracker": {
    "kind": "linear",
    "team": "STA",
    "branchPrefix": "figentra",
    "otherBranchPrefixes": ["delegate"],
    "token": ["LINEAR_AGENT_TOKEN", "LINEAR_API_KEY"]
  },
  "credentials": {
    "kind": "env"
  },
  "runner": {
    "kind": "command",
    "run": ["testbed", "run", "{label}", "{dir}", "{command}", "{flags}"]
  },
  "secrets": {
    "kind": "env"
  },
  "apps": {
    "gate": {
      "slug": "figentra-flow",
      "login": "figentra-flow[bot]"
    },
    "owner": "figentra-usr"
  },
  "gate": {
    "check": "pnpm verify"
  },
  "clean": {
    "keep": ["g-*", "*-gate", "land-*", "tpl-core", "c6-lock*", "template-wt-lean"]
  },
  "train": {
    "label": "train:",
    "eject": "bisect",
    "after": []
  }
}
