// Figentra Flow file contract:
// Purpose: oxfmt settings, matching Stackra core's line width. The bundled spec-kit assets are copies of what
//          `specify` renders and are kept byte for byte, so they are not formatted; nor is what `figentra-flow sync`
//          renders here, whose bytes .flow/lock.json pins (`gate ci` fails on a reformatted file).
{
  "printWidth": 100,
  "ignorePatterns": [
    "packages/figentra-flow/assets/**",
    "pnpm-lock.yaml",
    "**/CHANGELOG.md",
    ".agents/skills/**",
    ".agents/agents/**",
    ".agents/rules/**",
    ".github/workflows/figentra-flow-approve.yml",
  ],
}
