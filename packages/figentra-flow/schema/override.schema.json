{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "override.schema.json",
  "title": ".flow/overrides/<surface>/<id>.yml",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "const": "extend"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "values"],
      "properties": {
        "kind": {
          "const": "configure"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "file", "reason", "owner", "review"],
      "properties": {
        "kind": {
          "const": "replace"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "reason", "owner", "review"],
      "properties": {
        "kind": {
          "const": "disable"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  ]
}
