{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figentra-flow.config.schema.json",
  "title": "figentra-flow.config.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "preset": {
      "type": "string",
      "minLength": 1
    },
    "tracker": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "team", "branchPrefix"],
          "properties": {
            "kind": {
              "const": "linear"
            },
            "team": {
              "type": "string",
              "minLength": 1
            },
            "branchPrefix": {
              "type": "string",
              "minLength": 1
            },
            "token": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "branchPrefix"],
          "properties": {
            "kind": {
              "const": "github-issues"
            },
            "branchPrefix": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "site", "project", "branchPrefix"],
          "properties": {
            "kind": {
              "const": "jira"
            },
            "site": {
              "type": "string",
              "minLength": 1
            },
            "project": {
              "type": "string",
              "minLength": 1
            },
            "branchPrefix": {
              "type": "string",
              "minLength": 1
            },
            "token": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "credentials": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "env"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "gh-user"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "gh"],
          "properties": {
            "kind": {
              "const": "wrapper"
            },
            "gh": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "git": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "runner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "github-actions"
            },
            "workflow": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "host"],
          "properties": {
            "kind": {
              "const": "ssh"
            },
            "host": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "local"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "run"],
          "properties": {
            "kind": {
              "const": "command"
            },
            "run": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "secrets": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "env"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "paths"],
          "properties": {
            "kind": {
              "const": "infisical"
            },
            "paths": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "env": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "auth": {
              "enum": ["universal-auth"]
            },
            "bin": {
              "type": "string",
              "minLength": 1
            },
            "envFile": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["login"],
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1
            },
            "login": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug"],
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clean": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "enum": ["trivial", "small", "feature", "big"]
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
