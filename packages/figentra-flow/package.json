{
  "name": "@figentra-oss/flow",
  "version": "0.2.3",
  "private": false,
  "description": "Spec-driven development for agent teams: specs, approval stops, tasks, the gate, landing and releases, with presets and adapters for your tracker, runner, credentials and secrets",
  "keywords": [
    "linear",
    "sdlc",
    "spec-kit",
    "specs",
    "traceability",
    "workflow",
    "worktrees"
  ],
  "homepage": "https://github.com/figentra/flow#readme",
  "bugs": {
    "url": "https://github.com/figentra/flow/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/flow.git",
    "directory": "packages/figentra-flow"
  },
  "bin": {
    "fflow": "./bin/fflow.mjs",
    "figentra-flow": "./bin/figentra-flow.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/**/__tests__",
    "assets",
    "schema",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    "./gate": {
      "types": "./dist/src/commands/gate.d.mts",
      "default": "./src/commands/gate.mjs"
    },
    "./trace": {
      "types": "./dist/src/commands/trace.d.mts",
      "default": "./src/commands/trace.mjs"
    },
    "./parse": {
      "types": "./dist/src/lib/spec-parse.d.mts",
      "default": "./src/lib/spec-parse.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://npm.stackra.figentra.com/"
  },
  "scripts": {
    "build": "tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "node --test 'src/**/__tests__/*.test.mjs'",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@stackra/console": "catalog:",
    "@stackra/validation": "catalog:",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "developer",
    "runtimes": [
      "node"
    ],
    "summary": "Use it for spec-driven work: `fflow init` and `sync` install spec-kit with a preset and skills; `gate`, `trace`, `start`, `clean` and `land` run the stage gates, traceability, worktrees, the gate and landing."
  }
}
