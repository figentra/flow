{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.config.schema.json",
  "title": "flow.config.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "preset": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "harnesses": {
      "type": "array",
      "items": {
        "enum": ["claude-code", "opencode", "copilot", "cursor", "codex"]
      },
      "minItems": 1
    },
    "team": {
      "type": "string",
      "minLength": 1
    },
    "specs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "bugsDir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tracker": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "team", "branchPrefix"],
          "properties": {
            "kind": {
              "const": "linear"
            },
            "team": {
              "type": "string",
              "minLength": 1
            },
            "branchPrefix": {
              "type": "string",
              "minLength": 1
            },
            "otherBranchPrefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "token": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "branchPrefix"],
          "properties": {
            "kind": {
              "const": "github-issues"
            },
            "branchPrefix": {
              "type": "string",
              "minLength": 1
            },
            "otherBranchPrefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "site", "project", "branchPrefix"],
          "properties": {
            "kind": {
              "const": "jira"
            },
            "site": {
              "type": "string",
              "minLength": 1
            },
            "project": {
              "type": "string",
              "minLength": 1
            },
            "branchPrefix": {
              "type": "string",
              "minLength": 1
            },
            "otherBranchPrefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "token": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "credentials": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "env"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "gh-user"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "gh"],
          "properties": {
            "kind": {
              "const": "wrapper"
            },
            "gh": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "git": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "runner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "github-actions"
            },
            "workflow": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "host"],
          "properties": {
            "kind": {
              "const": "ssh"
            },
            "host": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "local"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "run"],
          "properties": {
            "kind": {
              "const": "command"
            },
            "run": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "secrets": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "secrets": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "env"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "sops"
            },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "required": ["decrypt", "scope"],
              "properties": {
                "decrypt": {
                  "type": "string",
                  "pattern": "^(?!.*\\.\\.)[\\w-]+/[\\w.-]+(?:/[\\w.-]+)*@[0-9a-f]{40}$"
                },
                "scope": {
                  "type": "string",
                  "pattern": "^[\\w-]+(?:/[\\w-]+)*$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "infisical"
            },
            "paths": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "env": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "auth": {
              "enum": ["universal-auth"]
            },
            "bin": {
              "type": "string",
              "minLength": 1
            },
            "envFile": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["login"],
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1
            },
            "login": {
              "type": "string",
              "minLength": 1
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug"],
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "shard": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownerOnly": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\w .()-]+$"
          }
        },
        "requesters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\w-]+$"
          }
        },
        "tolerate": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "enum": ["Baseline", "fflow/gate"]
            }
          }
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": {
          "type": "boolean"
        },
        "lefthook": {
          "type": "boolean"
        },
        "opencode": {
          "type": "boolean"
        }
      }
    },
    "clean": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mustPass": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "install": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "enum": ["trivial", "small", "feature", "big"]
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "train": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cutoff": {
          "type": "integer",
          "minimum": 1
        },
        "eject": {
          "enum": ["bisect", "manual"]
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "lefthook": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "agentsMd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facts": {
          "type": "string",
          "minLength": 1
        },
        "land": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pushAtEnd": {
          "type": "boolean"
        },
        "contextCommands": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "claudeCode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabledPlugins": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "extraKnownMarketplaces": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["source"],
            "properties": {
              "source": {
                "type": "object",
                "required": ["source"],
                "properties": {
                  "source": {
                    "enum": ["github", "git", "url"]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
