{
  "name": "@stackra/vellum",
  "version": "0.0.0",
  "private": false,
  "description": "Vellum: the spec CLI for Stackra repositories. Installs spec-kit's .specify/ with the Stackra preset, syncs the speckit skills, and runs the stage gates, traceability and Linear links",
  "keywords": [
    "linear",
    "sdlc",
    "spec-kit",
    "specs",
    "stackra",
    "traceability"
  ],
  "homepage": "https://github.com/figentra/vellum#readme",
  "bugs": {
    "url": "https://github.com/figentra/vellum/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/vellum.git",
    "directory": "packages/vellum"
  },
  "bin": {
    "vellum": "./bin/vellum.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/**/__tests__",
    "assets",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./gate": {
      "types": "./dist/src/commands/gate.d.mts",
      "default": "./src/commands/gate.mjs"
    },
    "./trace": {
      "types": "./dist/src/commands/trace.d.mts",
      "default": "./src/commands/trace.mjs"
    },
    "./parse": {
      "types": "./dist/src/lib/spec-parse.d.mts",
      "default": "./src/lib/spec-parse.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.stackra.figentra.com/"
  },
  "scripts": {
    "build": "tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "node --test 'src/**/__tests__/*.test.mjs'",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "undici": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "developer",
    "runtimes": [
      "node"
    ],
    "summary": "Use it for spec-driven work in a Stackra repository: `vellum init` and `vellum sync` install spec-kit with the Stackra preset and skills; `vellum gate`, `trace`, `parse` and `linear` run the stage gates, traceability and Linear links."
  }
}
