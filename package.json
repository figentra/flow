{
  "name": "vellum-workspace",
  "private": true,
  "description": "Vellum: the spec CLI for Stackra repositories (spec-kit preset, stage gates, traceability, Linear links)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify": "pnpm format:check && turbo run lint typecheck test build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-git": "catalog:release",
    "@changesets/cli": "catalog:release",
    "lefthook": "catalog:release",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "turbo": "catalog:build"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
